generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum TypeClosure {
  resolved
  mistake
  other
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  date_birth DateTime @db.Date
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  access_tokens    AccessToken[]
  occurrences      Occurrence[]
  like_occurrences LikeOccurrence[]

  @@map("users")
}

model AccessToken {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token_hash String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @default(dbgenerated("(NOW() + INTERVAL '7 days')")) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("access_tokens")
}

model TypeOccurrence {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  occurrences Occurrence[]

  @@map("types_occurrence")
}

model Occurrence {
  id                   Int          @id @default(autoincrement())
  location             Unsupported("geometry(Point, 4326)")
  type_id              Int
  user_id              Int
  description          String       @default("") @db.Text
  address_name         String       @default("") @db.Text
  city                 String?
  state                String?
  country              String?
  is_active            Boolean      @default(true)
  type_closure         TypeClosure?
  solution_description String?
  resolution_date      DateTime?    @db.Date
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  type             TypeOccurrence   @relation(fields: [type_id], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  like_occurrences LikeOccurrence[]

  @@map("occurrences")
}

model LikeOccurrence {
  id            Int      @id @default(autoincrement())
  user_id       Int
  occurrence_id Int
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  occurrence Occurrence @relation(fields: [occurrence_id], references: [id], onDelete: Cascade)

  @@unique([user_id, occurrence_id])
  @@map("like_occurrences")
}
