# Runtime da aplicação. Na Vercel, use a connection string do pooler com sslmode=require.
DATABASE_URL=postgresql://mapa_cidadao:mapa_cidadao@localhost:5432/mapa_cidadao

# Migrations e seed. Localmente pode repetir a DATABASE_URL.
# Na Vercel/Neon, use a connection string direta, sem o host "-pooler".
DIRECT_URL=postgresql://mapa_cidadao:mapa_cidadao@localhost:5432/mapa_cidadao

# Opcional. Sem esta chave o mapa usa os tiles do OpenStreetMap.
NUXT_PUBLIC_CARTO_API_KEY=
